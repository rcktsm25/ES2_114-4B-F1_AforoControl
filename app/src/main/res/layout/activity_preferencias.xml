<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".views.PreferenciasActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloPreferencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preferencias de Aforo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtSubtituloPreferencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configura los parámetros de monitoreo IoT"
            android:textSize="14sp"
            android:textColor="@color/color_gray"
            app:layout_constraintTop_toBottomOf="@id/txtTituloPreferencias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/contenedorPreferencias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/txtSubtituloPreferencias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Switch propio del negocio: Indicador 7 -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAlertaSobrecupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activar alerta acústica por sobrecupo"
                android:textSize="16sp"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Zona o sala monitoreada:"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <!-- Spinner con opciones del negocio: Indicador 7 -->
            <Spinner
                android:id="@+id/spZonaMonitoreada"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:entries="@array/zonas_monitoreadas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Umbral de alerta de capacidad:"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <RadioGroup
                android:id="@+id/rgUmbral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbAlerta80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerta temprana al 80% del aforo"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbAlerta100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerta crítica al 100% (Capacidad máxima)" />

            </RadioGroup>

            <ProgressBar
                android:id="@+id/pbGuardando"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGuardarPreferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Guardar Preferencias"
                android:onClick="onGuardarPreferenciaClick" />

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Volver"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:onClick="onVolverClick" />

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cerrar Sesión"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/color_danger"
                android:onClick="onCerrarSesionClick" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
