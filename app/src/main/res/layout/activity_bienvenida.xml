<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".views.BienvenidaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogoBienvenida"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_aforo_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Saludo que muestra el email recibido por Intent -->
        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bienvenido"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/imgLogoBienvenida"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Presentación del servicio del proyecto IoT -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardServicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD"
            app:layout_constraintTop_toBottomOf="@id/txtBienvenida"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servicio AforoControl IoT"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:id="@+id/txtDescripcionServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Monitoreo y control inteligente de aforo de personas en tiempo real en los espacios de la Sede INACAP Puente Alto (Auditorio, Biblioteca, Laboratorios y Casino) para prevenir sobrecupo mediante sensores IoT."
                    android:textSize="14sp"
                    android:textColor="@color/black" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de navegación -->
        <Button
            android:id="@+id/btnLecturas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Monitoreo de Aforo (Lista IoT)"
            android:onClick="onLecturasClick"
            app:layout_constraintTop_toBottomOf="@id/cardServicio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnPreferencias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preferencias del Sistema"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:onClick="onPreferenciasClick"
            app:layout_constraintTop_toBottomOf="@id/btnLecturas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cerrar Sesión"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/color_danger"
            android:onClick="onCerrarSesionClick"
            app:layout_constraintTop_toBottomOf="@id/btnPreferencias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
